{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "src.core.logging.build_json_formatter"
    }
  },
  "handlers": {
    "json_stdout": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["json_stdout"]
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": ["json_stdout"],
      "propagate": false
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": ["json_stdout"],
      "propagate": false
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": ["json_stdout"],
      "propagate": false
    }
  }
}
