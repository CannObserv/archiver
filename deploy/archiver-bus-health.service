[Unit]
Description=Archiver outbox health probe - WARN-only (archiver#130, reduced by #193)
# Deliberately NOT bound to archiver.service: the probe exists precisely to
# report while it is down. An unreachable database is a finding it logs, never
# a dependency failure.
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/archiver

# Same env layering as archiver.service: production secrets, then optional
# repo-local overrides.
EnvironmentFile=/etc/archiver/.env
EnvironmentFile=-/home/exedev/archiver/.env

# The probe runs one read-only query against the production changes_outbox
# (the same stats query as the #112 badge, from outside the publisher process
# - the backlog it catches is the one the in-loop stats line cannot report).
# src/core/db_safety.py gates that connection; the opt-in lives HERE, in a
# unit, never in an env file - an EnvironmentFile is sourced by every process
# that loads it, which is exactly the hole the guard closes. This unit and
# archiver.service are the only two sanctioned holders.
Environment=ARCHIVER_ALLOW_PRODUCTION_DB=1

# ARCHIVER_BUS_CONSUMER is deliberately absent, and now doubly so: this probe
# opens no Redis connection at all (archiver#193 Phase 3). Joining the
# archiver.revisions group from here would silently swallow revisions (#139).

# Reduced to the outbox half by archiver#193 Phase 3. The broker-side checks
# - memory, per-stream XLEN, last-entry age, the two-tick XPENDING rule, the
# DLQ sweep, disk - moved to CannObserv/broker's broker-bus-health.timer,
# which runs on the broker's own node. Run from here they had begun measuring
# archiver's disk and calling it the broker's AOF headroom (archiver#193 D6).
#
# The two-tick rule was the only thing that needed state between oneshot runs,
# so StateDirectory= and --state-file went with it. Nothing here is stateful.
#
# Reduced rather than retired in favour of the #147 dashboard panel: the
# reason this unit exists survives the split intact - the publisher's own
# outbox stats line rides the drain loop and vanishes exactly when the
# publisher is down, and a journald line fires whether or not an operator is
# looking at a page.

# Hard backstop under systemd's 90s default. The tick is now a single database
# query, and asyncpg's connect carries no default timeout, so a Postgres that
# hangs rather than refuses would otherwise hold this unit open indefinitely.
# A tick that cannot finish in 60s has nothing useful left to report, and being
# visibly killed beats hanging the unit.
TimeoutStartSec=60

ExecStart=/usr/local/bin/uv run python -m src.core.bus_health
