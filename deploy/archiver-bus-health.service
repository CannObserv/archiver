[Unit]
Description=Archiver bus health probe - broker + outbox + disk, WARN-only (archiver#130)
# Deliberately NOT bound to archiver.service or redis-server.service: the probe
# exists precisely to report while either of them is down. An unreachable
# broker or database is a finding it logs, never a dependency failure.
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/archiver

# Same env layering as archiver.service: production secrets, then optional
# repo-local overrides.
EnvironmentFile=/etc/archiver/.env
EnvironmentFile=-/home/exedev/archiver/.env

# The probe runs one read-only query against the production changes_outbox
# (the same stats query as the #112 badge, from outside the publisher process
# - the backlog it catches is the one the in-loop stats line cannot report).
# src/core/db_safety.py gates that connection; the opt-in lives HERE, in a
# unit, never in an env file - an EnvironmentFile is sourced by every process
# that loads it, which is exactly the hole the guard closes. This unit and
# archiver.service are the only two sanctioned holders.
Environment=ARCHIVER_ALLOW_PRODUCTION_DB=1

# ARCHIVER_BUS_CONSUMER is deliberately absent: XPENDING is read-only group
# introspection. Joining the archiver.revisions group from here would silently
# swallow revisions (archiver#139).

# Carries the two-tick XPENDING state between oneshot runs
# (/var/lib/archiver-bus-health, owned by User= automatically).
StateDirectory=archiver-bus-health

# Hard backstop under systemd's 90s default. src/core/bus_health.py bounds each
# Redis call (5s connect / 10s read), but ~25 calls per tick could in theory
# accumulate past the default against a uniformly slow broker. A healthy tick
# takes well under a second; one that cannot finish in 60s has nothing useful
# left to report, and being visibly killed beats hanging the unit.
TimeoutStartSec=60

ExecStart=/usr/local/bin/uv run python -m src.core.bus_health --state-file ${STATE_DIRECTORY}/state.json
