[Unit]
Description=Periodic archiver outbox health probe (archiver#130)

[Timer]
# 10-minute cadence, unchanged by the archiver#193 Phase 3 reduction. The
# #112 in-loop stats line (300s) stays the faster signal while the publisher
# is alive; this timer is the one that keeps reporting when it is not, which
# is the whole reason it survived the split. The two-tick XPENDING rule that
# also motivated this interval now runs on the broker's own node, on the same
# cadence, from CannObserv/broker.
OnBootSec=2min
OnUnitActiveSec=10min
AccuracySec=1min

[Install]
WantedBy=timers.target
