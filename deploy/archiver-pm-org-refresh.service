[Unit]
Description=Archiver Power Map org follower - one refresh sweep (archiver#305)
# Not bound to archiver.service: the sweep needs Postgres and Power Map, not
# the API process. An unreachable Power Map is a journald line and the next
# run's retry, never a failed unit.
After=network.target postgresql.service

[Service]
Type=oneshot
# archiver#339, as archiver.service.
User=archiver
Group=archiver
# The live release, as archiver.service (archiver#330).
WorkingDirectory=/srv/archiver/live

# Same env as archiver.service, /etc/archiver/.env only. It carries
# ARCHIVER_POWER_MAP_API_KEY; with no key the follower exits 0 without
# touching the database (dormant).
EnvironmentFile=/etc/archiver/.env

# The follower writes pm_organizations (snapshots, missing_since, merged_into)
# and re-points info_items.pm_org_id on a merge, on the production database.
# src/core/db_safety.py gates that connection; the opt-in lives HERE, in a
# unit, never in an env file - an EnvironmentFile is sourced by every process
# that loads it, which is exactly the hole the guard closes.
Environment=ARCHIVER_ALLOW_PRODUCTION_DB=1

# ARCHIVER_BUS_CONSUMER is deliberately absent: the follower opens no Redis
# connection, and joining the archiver.revisions group from here would
# silently swallow revisions (#139).

# Requests are paced at 2/s for Power Map's read bucket, so a sweep is linear
# in linked orgs. 15 minutes covers ~1800 of them and stays well inside the
# hourly cadence, so two sweeps never overlap; past it, being visibly killed
# beats hanging.
TimeoutStartSec=900

# The release's interpreter, not `uv run`: uv wants $HOME (archiver#339).
ExecStart=/srv/archiver/live/.venv/bin/python -m src.core.tools.refresh_orgs

# As archiver.service: nothing writes outside PrivateTmp, nothing reads /home.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
