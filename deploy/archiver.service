[Unit]
Description=Archiver service — Cannabis Observer information registry
After=network.target postgresql.service
# The redis-server ordering is GONE, not loosened (CannObserv/broker#1 Phase 3).
# The broker no longer runs on this host: it moved to a neutral node reached
# over the tailnet, so there is no local unit to order behind and `Wants=` would
# name a service that will never exist here.
#
# The reasoning it replaces is still true and still load-bearing, so it is
# restated rather than dropped: Archiver is the change-bus producer, and the
# outbox tolerates broker downtime within its retry window. A broker that is
# down, unreachable, or slow must never stop Archiver from starting — it
# degrades the publisher and nothing else (#109). What changes is only that the
# dependency is now a network hop with an explicit connection policy
# (src/core/changes/bus_client.py, archiver#193) instead of a local unit.

[Service]
Type=simple
# Its own user (archiver#339): a system account with no login, no home, no
# sudo. exedev, the agents' and humans' account, can neither read this unit's
# secrets nor signal or trace its processes. Nothing in the release is its own.
User=archiver
Group=archiver
# A release, never the checkout (archiver#330): scripts/deploy.sh builds
# releases/<build> from a pushed main commit and points `live` at it. A branch
# switch, an uncommitted edit or a `uv sync` in /home/exedev/archiver changes
# nothing this unit runs. systemd resolves the link once, at start, so a later
# swap never hands a running process another release's modules.
WorkingDirectory=/srv/archiver/live

# Production secrets only. No repo .env (the agents' PATs), and no BUILD_ID
# stamp: /health's build_id is the release's REVISION (src/core/build.py).
# root:root 0600: systemd reads it before dropping to User=, so neither this
# user nor exedev can (archiver#339).
EnvironmentFile=/etc/archiver/.env

# This unit is the ONLY sanctioned writer of the production registry.
# src/core/db_safety.py refuses to serve a database whose name lacks a
# _test/_dev suffix unless this is set, so a hand-rolled uvicorn cannot reach
# production regardless of which env files it sourced (2026-07-18 incident).
# Keep this AFTER the EnvironmentFile lines so it cannot be overridden by them.
Environment=ARCHIVER_ALLOW_PRODUCTION_DB=1

# This unit is likewise the ONLY sanctioned member of the archiver.revisions
# consumer group on content.revisions (archiver#139). Publishing from a stray
# process is merely noisy; consuming REMOVES messages from the group, so any
# process that sources /etc/archiver/.env — an agent shell, a one-off script —
# would silently swallow revisions into whatever database it holds. Same
# placement rule as above: after the EnvironmentFile lines, and never in an env
# file, or the hole reopens for every process that sources them.
Environment=ARCHIVER_BUS_CONSUMER=1

# No wheelhouse sync here any more: the private wheels are fetched into the
# release at deploy time (archiver#330 D10), so a start never depends on GCS.

# Assert the Redis change-bus server floor (>=7.0) when the bus is active.
# NOT prefixed with `-`: a genuinely-too-old *reachable* broker must block the
# producer (the consumer path's XAUTOCLAIM needs 7.0). The script is itself soft
# on the dormant/unreachable cases — it exits 0 when ARCHIVER_REDIS_URL is unset
# or the broker cannot be reached, so it only fails start on a real downgrade.
ExecStartPre=/srv/archiver/live/scripts/check_redis_floor.sh

# --log-config routes uvicorn's own loggers (uvicorn/.access/.error) through the
# same JSON formatter as app logs (archiver#122) — without it journald gets
# mixed plain-text + JSON lines. Path is relative to WorkingDirectory.
# The venv's own uvicorn, not `uv run`: uv wants a cache under $HOME, and this
# user has none (archiver#339). It never syncs; syncing is a build step. Its
# shebang names the release's physical path, so a later switch of the link
# never mixes two releases in one process.
ExecStart=/srv/archiver/live/.venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --log-config src/core/log_config.json
Restart=on-failure
RestartSec=5

# Memory reservation (archiver#237). This host is 7.7 GiB with a 4 G swapfile
# (archiver#286) and shares its kernel with agent sessions. They read
# oom_score_adj 0 since exe-init 14fd603 (archiver#285; -1000 before, when no
# killer could take one and this service was what went -
# gregoryfoster/skills#295, row U).
#
# MemoryLow is a soft floor, not a cap: reclaim leaves the working set alone
# under pressure. Sized above the measured 193 MiB peak (2026-09-28). Inert
# unless every slice above grants it: deploy/system.slice.d/ does. Never
# MemoryHigh=/MemoryMax= here - a cap bounds the victim, not the cause.
MemoryLow=256M
# Behind every killable process - sessions included, at 0 - but not -1000: an
# unkillable service wedges the box rather than shedding one process - swap
# only slows the leak down. Applied at start, so a change needs a restart.
OOMScoreAdjust=-500

# The release is read-only and its bytecode compiled at build, so nothing writes
# outside PrivateTmp. ProtectHome= keeps this user out of ~exedev, and its PATs
# (archiver#339, as processor).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
