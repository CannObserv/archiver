[Unit]
Description=Detect watcher_client snapshot drift vs live Watcher, open a PR (Layer C, archiver#70)
# Needs live Watcher on localhost:8000 (same VM) for both the detector fetch and
# regen.sh. Watcher readiness is intentionally NOT ordered here: it's a separate
# unit, and an unreachable Watcher is handled by the detector's exit-3 skip, so
# ordering after it would buy nothing.
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/archiver

# uv lives in /usr/local/bin; gh/git/bash in /bin. systemd gives a minimal PATH,
# so make the tools the wrapper shells out to discoverable.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# GH_TOKEN (for gh) + any git credential config. The wrapper also sources these
# itself so it works when run by hand; loading here keeps the systemd run honest.
EnvironmentFile=/etc/archiver/.env
EnvironmentFile=-/home/exedev/archiver/.env

# Keep the checkout current BEFORE the wrapper is read/executed, so the wrapper
# never fast-forwards the clone it is running from. Leading '-' = never block the
# detection run on a skipped/failed fast-forward (the script always exits 0
# anyway; the '-' is belt-and-suspenders).
ExecStartPre=-/bin/bash /home/exedev/archiver/scripts/ff_deploy_clone.sh

ExecStart=/bin/bash /home/exedev/archiver/scripts/watcher_live_drift_pr.sh

# Non-blocking by design: a down/unreachable Watcher exits 0 (skip). A non-zero
# exit is a genuine tooling failure worth a journal entry, not a restart loop.
