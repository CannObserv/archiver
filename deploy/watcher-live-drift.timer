[Unit]
Description=Daily watcher_client live-drift check (Layer C, archiver#70)

[Timer]
# Once a day. Persistent=true runs a missed timer after the VM was off, so a
# drift that appeared overnight is still caught on next boot.
OnCalendar=daily
Persistent=true
# Spread the fire time so it doesn't stampede other daily jobs.
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
